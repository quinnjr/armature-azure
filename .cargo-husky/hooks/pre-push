#!/bin/sh
# Pre-push hook — checks are scoped to this crate only.
set -e

echo "🚀 Running pre-push checks..."
echo ""

# Refuse direct pushes to protected branches, decided from the refs actually
# being pushed (git supplies them on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>" per ref).
pushed_refs=$(cat)

if printf '%s\n' "$pushed_refs" \
    | awk '{ print $3 }' \
    | grep -qE '^refs/heads/(main|master)$'; then
    echo "❌ Direct push to a protected branch (main/master) is not allowed!"
    echo "   Please create a pull request instead."
    echo ""
    exit 1
fi

# Tag-only pushes and deletes skip the compile/test gate.
if [ -n "$pushed_refs" ] && ! printf '%s\n' "$pushed_refs" \
    | awk '{ print $3 }' | grep -qE '^refs/heads/'; then
    echo "ℹ️  No branch refs in this push (tags only) — skipping compile/test gate."
    echo ""
    exit 0
fi

echo "🔨 Running cargo check..."
if ! cargo check --all-targets; then
    echo ""
    echo "❌ Cargo check failed!"
    echo ""
    exit 1
fi
echo "✅ Cargo check passed"
echo ""

echo "🧪 Running tests..."
if ! cargo test; then
    echo ""
    echo "❌ Tests failed!"
    echo ""
    exit 1
fi
echo "✅ All tests passed"
echo ""

echo "📚 Running doc tests..."
if ! cargo test --doc; then
    echo ""
    echo "❌ Doc tests failed!"
    echo ""
    exit 1
fi
echo "✅ Doc tests passed"
echo ""

echo "📖 Checking documentation builds..."
if ! cargo doc --no-deps --quiet; then
    echo ""
    echo "❌ Documentation build failed!"
    echo ""
    exit 1
fi
echo "✅ Documentation builds successfully"
echo ""

echo "✨ Pre-push checks complete! Safe to push."
echo ""

exit 0
